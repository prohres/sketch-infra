# Copy to accounts.env (not in git) and fill in; load before terraform: set -a; . ../accounts.env; set +a
# CI sets TF_VAR_account_id itself (ci-templates tf-setup); the other two are used only by the manual ci/ and bootstrap/ stacks.
TF_VAR_account_id=<management-account-id>
TF_VAR_admin_account_id=<ci-hub-account-id>
TF_VAR_dev_account_id=<workload-account-id>
